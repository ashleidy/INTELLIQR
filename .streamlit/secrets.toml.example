# Copia este archivo a .env (local, fuera de git) o traslada estos valores a
# .streamlit/secrets.toml / Streamlit Cloud → Settings → Secrets.
#
# NUNCA subas el archivo real al repositorio.

# URL de tu Web App de Google Apps Script. Debe terminar en /exec
GOOGLE_SCRIPT_URL = ""

# Cadena larga y aleatoria, la misma que pones en las Propiedades del script.
# Sin ella, cualquiera que descubra la URL puede crear y editar tus QR.
API_TOKEN = ""

# Segundos antes de dar una petición por perdida (5-60).
REQUEST_TIMEOUT = "20"

# es | en
DEFAULT_LANGUAGE = "es"
